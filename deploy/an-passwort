#!/usr/bin/env bash
# Setzt das Passwort fuer die Verwaltungsseite https://abrechnungs-navi.de/verwaltung
# Benutzername: volker
set -euo pipefail
echo "Neues Passwort fuer die Verwaltung (Benutzer: volker)."
echo "Bitte NUR Buchstaben a-x / A-X und Ziffern 0-9 verwenden (kein Y, kein Z, keine Sonderzeichen),"
echo "mindestens 12 Zeichen. Beim Tippen erscheint nichts."
read -rs -p "Passwort: " P1; echo
read -rs -p "Nochmal:  " P2; echo
if [ "$P1" != "$P2" ]; then echo "Die beiden Eingaben sind verschieden. Bitte nochmal: an-passwort"; exit 1; fi
if ! [[ "$P1" =~ ^[A-Xa-x0-9]{12,}$ ]]; then echo "Nicht erlaubt (nur a-x, A-X, 0-9, mind. 12 Zeichen). Bitte nochmal: an-passwort"; exit 1; fi
HASH=$(caddy hash-password --plaintext "$P1")
unset P1 P2
printf 'basicauth {\n\tvolker %s\n}\n' "$HASH" > /etc/caddy/an-admin-auth.caddy
chmod 640 /etc/caddy/an-admin-auth.caddy
chgrp caddy /etc/caddy/an-admin-auth.caddy 2>/dev/null || true
caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 && systemctl reload caddy
echo "FERTIG: Passwort gesetzt. Anmelden unter /verwaltung mit Benutzer volker."
