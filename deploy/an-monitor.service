[Unit]
Description=Abrechnungs-Navi Sicherheitsueberwachung
After=network-online.target
[Service]
Type=oneshot
ExecStart=/srv/an-upload/venv/bin/python /srv/an-upload/app/monitor.py
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=an-monitor
ReadWritePaths=/var/lib/an-monitor
