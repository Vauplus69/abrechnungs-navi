#!/usr/bin/env bash
# Keine Zugangsdaten im Repository. Konfiguration ausschliesslich root-lesbar.
set -euo pipefail
exec 9>/run/lock/an-backup.lock
flock -n 9 || exit 0
set -a
source /etc/an-upload/backup.env
set +a
: "${RESTIC_REPOSITORY:?Externer Sicherungsort fehlt}"
: "${RESTIC_PASSWORD_FILE:?Passwortdatei fehlt}"
case "$RESTIC_REPOSITORY" in /*|file:* ) echo 'Nur externer Sicherungsort erlaubt'; exit 1;; esac
command -v restic >/dev/null || { echo 'restic muss installiert sein'; exit 1; }
RESTIC_OPTIONS=()
if [ -n "${AN_SFTP_COMMAND:-}" ]; then RESTIC_OPTIONS=(-o "sftp.command=$AN_SFTP_COMMAND"); fi
# Alle AN-Schreiber fuer den Sicherungsstand koordinieren. Keine fremden Dienste.
PAUSED_TIMERS=()
finish_backup() {
  result=$?
  systemctl start an-upload || true
  for timer in "${PAUSED_TIMERS[@]}"; do systemctl start "$timer" || true; done
  if [ "$result" -ne 0 ]; then
    date +%s > /etc/an-upload/backup-last-failure
    chmod 600 /etc/an-upload/backup-last-failure
    systemctl start --no-block an-monitor.service || true
  fi
  exit "$result"
}
trap finish_backup EXIT
for timer in an-payment-worker.timer an-agent-worker.timer an-notification-worker.timer; do
  if systemctl is-active --quiet "$timer"; then
    PAUSED_TIMERS+=("$timer")
    systemctl stop "$timer"
  fi
done
# Laufende API-/SMTP-Aufrufe geordnet beenden lassen statt sie blind abzubrechen.
for unit in an-payment-worker.service an-agent-worker.service an-notification-worker.service; do
  deadline=$((SECONDS + 700))
  while [[ "$(systemctl show -p ActiveState --value "$unit" 2>/dev/null)" =~ ^(active|activating|deactivating|reloading)$ ]]; do
    [ "$SECONDS" -lt "$deadline" ] || { echo 'AN-Hintergrunddienst beendet sich nicht rechtzeitig'; exit 1; }
    sleep 1
  done
done
systemctl stop an-upload
# Vollstaendiger AN-Wiederanlauf: Daten, Programmstand und eigene Konfiguration.
# Der Entschluesselungsschluessel bleibt separat; kein fremder Dienst wird gesichert.
restic "${RESTIC_OPTIONS[@]}" backup \
  /srv/an-upload/data /srv/an-upload/invoices /srv/an-upload/app /srv/an-upload/.version \
  /var/www/abrechnungs-navi /etc/an-upload \
  /etc/caddy/abrechnungs-navi.caddy /etc/caddy/an-admin-auth.caddy \
  /etc/systemd/system/an-upload.service \
  /etc/systemd/system/an-payment-worker.service /etc/systemd/system/an-payment-worker.timer \
  /etc/systemd/system/an-agent-worker.service /etc/systemd/system/an-agent-worker.timer \
  /etc/systemd/system/an-notification-worker.service /etc/systemd/system/an-notification-worker.timer \
  /etc/systemd/system/an-backup.service /etc/systemd/system/an-backup.timer \
  /etc/systemd/system/an-monitor.service /etc/systemd/system/an-monitor.timer \
  /etc/systemd/system/an-aktualisieren.service /etc/systemd/system/an-aktualisieren.timer \
  /usr/local/bin/an-aktualisieren /usr/local/bin/an-betriebsfreigabe \
  /usr/local/bin/an-backup /usr/local/bin/an-passwort /usr/local/bin/an-mailpasswort \
  --exclude /etc/an-upload/restic-password --tag abrechnungs-navi --quiet
systemctl start an-upload
restic "${RESTIC_OPTIONS[@]}" forget --tag abrechnungs-navi --keep-within 28d --prune --quiet
restic "${RESTIC_OPTIONS[@]}" check --quiet
install -d -m 750 -o root -g annavi /etc/an-upload
date +%s > /etc/an-upload/backup-last-success
chown root:annavi /etc/an-upload/backup-last-success
chmod 640 /etc/an-upload/backup-last-success
