# Abrechnungs-Navi – wird von deploy/setup.sh nach /etc/caddy/ kopiert
abrechnungs-navi.de {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output discard
	}

	request_body /hochladen/api/* {
		max_size 26MB
	}

	handle /hochladen/* {
		reverse_proxy 127.0.0.1:8790
	}

	handle /verwaltung* {
		import /etc/caddy/an-admin-auth.caddy
		reverse_proxy 127.0.0.1:8790
	}

	handle {
		root * /var/www/abrechnungs-navi
		file_server
	}
}

www.abrechnungs-navi.de {
	redir https://abrechnungs-navi.de{uri} permanent
}
