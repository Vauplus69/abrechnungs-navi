#!/bin/bash
# Schritt: 1) neue Startseite mit Themen-Leiste einspielen. 2) Bezahl-Dienst nur, wenn noch nicht eingerichtet und gewuenscht.
H="Accept: application/vnd.github.raw"; R="https://api.github.com/repos/Vauplus69/abrechnungs-navi/contents"
curl -fsSL -H "$H" "$R/startseite/einspielen.sh?ref=anspruchskompass" -o /root/startseite-einspielen.sh && bash /root/startseite-einspielen.sh || exit 1
if [ ! -x /usr/local/bin/ak-zahlung ] || ! grep -q '^SMTP_PASS=.' /opt/ak-zahlung/.env 2>/dev/null || ! grep -q '^MOLLIE_KEY=.' /opt/ak-zahlung/.env 2>/dev/null; then
  echo
  read -r -p "Bezahlung (Mollie) jetzt auch einrichten? Dafuer brauchst du den Mollie-Test-Schluessel. (Enter = ja, n = nein): " A </dev/tty
  if [ "$A" != n ] && [ "$A" != N ]; then
    curl -fsSL -H "$H" "$R/zahlung/einrichten.sh?ref=anspruchskompass" -o /root/zahlung-einrichten.sh && bash /root/zahlung-einrichten.sh
  else
    echo "Ok, Bezahlung bleibt aus. Spaeter einfach wieder ak tippen."
  fi
fi
