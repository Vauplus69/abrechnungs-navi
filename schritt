#!/bin/bash
clear
echo "== Caddy log-Eintraege:"; grep -n -A3 "log" /etc/caddy/Caddyfile /opt/anspruchskompass/Caddyfile 2>/dev/null | head -12
echo "== Docker Log-Einstellung:"; cat /etc/docker/daemon.json 2>/dev/null; docker inspect -f '{{.HostConfig.LogConfig}}' anspruchskompass-app-1
echo "== journald:"; grep -E "^(MaxRetentionSec|SystemMaxUse)" /etc/systemd/journald.conf; journalctl --disk-usage
echo "== Sicherungen:"; systemctl list-timers --all | grep -i backup | cut -c1-120
grep -nE "maxAge|RETAIN|days|7" /opt/anspruchskompass/backup.mjs | head -5
