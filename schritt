#!/bin/bash
set -e
clear
# 1) Server-Meldungen (journald) auf 14 Tage begrenzen
mkdir -p /etc/systemd/journald.conf.d
printf '[Journal]\nMaxRetentionSec=14day\n' > /etc/systemd/journald.conf.d/14-tage.conf
systemctl restart systemd-journald
journalctl --vacuum-time=14d 2>&1 | tail -1
echo "== rsyslog/logrotate:"; dpkg -l rsyslog 2>/dev/null | grep -c ^ii || true; ls /var/log/*.log 2>/dev/null | head -8; grep -E "weekly|daily|rotate|maxage" /etc/logrotate.d/rsyslog 2>/dev/null | head -5
echo "== compose logging:"; grep -n -A4 logging /opt/anspruchskompass/compose.yaml || true
# 2) Programmcode verschluesselt zum Lesen bereitstellen (nur mit Claudes Schluessel lesbar)
