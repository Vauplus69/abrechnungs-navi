#!/bin/bash
# Neue Vorschau-Dateien einspielen und App neu bauen. index.html bleibt unveraendert.
set -e
clear
A=/opt/anspruchskompass
T=$(mktemp -d)
curl -fsSL https://codeload.github.com/Vauplus69/abrechnungs-navi/tar.gz/anspruchskompass | tar xz -C "$T" --strip-components=1
cp "$T"/neu/* $A/public/
cd $A && docker compose build -q && docker compose up -d && sleep 8
for p in /vorschau /kompass /kompass-neu.css /app-neu.js /; do printf '%-18s %s\n' "$p" "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8787$p)"; done
docker compose ps --format '{{.Status}}'
echo FERTIG
