// Loeschung ungenutzter Konten nach 12 Monaten ohne Anmeldung.
// Vorher (mindestens 30 Tage) Hinweis an die bestaetigte E-Mail-Adresse, falls vorhanden.
// Konten mit laufendem bezahltem Vertrag werden nicht geloescht.
export const INACTIVE_MS = 365 * 86400000;
export const NOTICE_MS = 30 * 86400000;

export function retention(db, {recordDeletion, sendInactiveNotice, keepAccount = () => false, now = Date.now} = {}) {
 const columns = db.prepare('PRAGMA table_info(users)').all().map(c => c.name);
 if (!columns.includes('last_active')) db.exec('ALTER TABLE users ADD COLUMN last_active INTEGER');
 if (!columns.includes('inactive_notice_at')) db.exec('ALTER TABLE users ADD COLUMN inactive_notice_at INTEGER');
 // Bestehende Konten ohne Zeitstempel gelten ab heute als aktiv.
 db.prepare('UPDATE users SET last_active=? WHERE last_active IS NULL').run(now());
 let running = null;

 function touch(userId) {
  db.prepare('UPDATE users SET last_active=?,inactive_notice_at=NULL WHERE id=?').run(now(), userId);
 }

 function verifiedEmail(userId) {
  try { return db.prepare('SELECT email FROM account_emails WHERE user_id=?').get(userId)?.email || null; }
  catch { return null; }
 }

 async function run() {
  const t = now();
  // 1) Hinweise verschicken
  const noticeDue = db.prepare('SELECT id FROM users WHERE last_active<? AND inactive_notice_at IS NULL').all(t - INACTIVE_MS + NOTICE_MS);
  for (const {id} of noticeDue) {
   if (keepAccount(id)) continue;
   if (db.isTransaction) return;
   const marked = now();
   db.prepare('UPDATE users SET inactive_notice_at=? WHERE id=? AND inactive_notice_at IS NULL').run(marked, id);
   const email = verifiedEmail(id);
   if (email && sendInactiveNotice) {
    const row = db.prepare('SELECT last_active FROM users WHERE id=?').get(id);
    const deleteOn = new Date(Math.max(row.last_active + INACTIVE_MS, marked + NOTICE_MS));
    try { await sendInactiveNotice({email, deleteOn}); }
    catch {
     if (!db.isTransaction) db.prepare('UPDATE users SET inactive_notice_at=NULL WHERE id=? AND inactive_notice_at=?').run(id, marked);
     console.error('Inactive account notice failed.');
    }
   }
  }
  // 2) Loeschen: 12 Monate ohne Anmeldung und Hinweis vor mindestens 30 Tagen markiert
  const t2 = now();
  const due = db.prepare('SELECT id FROM users WHERE last_active<? AND inactive_notice_at IS NOT NULL AND inactive_notice_at<?').all(t2 - INACTIVE_MS, t2 - NOTICE_MS);
  for (const {id} of due) {
   if (keepAccount(id)) continue;
   if (db.isTransaction) return;
   db.exec('BEGIN IMMEDIATE');
   try {
    const still = db.prepare('SELECT 1 FROM users WHERE id=? AND last_active<? AND inactive_notice_at<?').get(id, t2 - INACTIVE_MS, t2 - NOTICE_MS);
    if (still) { recordDeletion(id); db.prepare('DELETE FROM users WHERE id=?').run(id); }
    db.exec('COMMIT');
   } catch (e) { if (db.isTransaction) db.exec('ROLLBACK'); throw e; }
  }
 }

 return {
  touch,
  tick() { if (!running) running = run().finally(() => { running = null; }); return running; },
  settled() { return running || Promise.resolve(); }
 };
}
RET
